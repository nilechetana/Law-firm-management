<%- include('../partials/html') %>
<head>
  <%- include('../partials/title-meta') %>
  <%- include('../partials/head-css') %>
</head>

<body>
<div class="wrapper">
  <%- include('../partials/menu') %>

  <div class="page-content">
    <div class="page-container">

      <h4 class="mb-4">Create Invoice</h4>

      <form id="invoiceForm">

        <!-- Client / Case -->
        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label">Client</label>
            <select id="client_id" class="form-select">
              <option value="">Select Client</option>
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">Case</label>
            <select id="case_id" class="form-select">
              <option value="">Select Case</option>
            </select>
          </div>
        </div>

        <!-- Dates -->
        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label">Invoice Date</label>
            <input type="date" id="invoice_date" class="form-control">
          </div>

          <div class="col-md-6">
            <label class="form-label">Due Date</label>
            <input type="date" id="due_date" class="form-control">
          </div>
        </div>

        <!-- Location -->
        <div class="row mb-3">
          <div class="col-md-3">
            <label class="form-label">Country</label>
            <select id="country" class="form-select">
              <option value="India">India</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="col-md-3">
            <label class="form-label">Currency</label>
            <select id="currency" class="form-select">
              <option value="INR">INR (₹)</option>
              <option value="USD">USD ($)</option>
            </select>
          </div>

          <div class="col-md-3">
            <label class="form-label">State</label>
            <input id="state" class="form-control">
          </div>

          <div class="col-md-3">
            <label class="form-label" id="taxLabel">GST (%)</label>
            <input id="tax_rate" type="number" class="form-control" value="18">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Taxable</label>
          <select id="taxable" class="form-select">
            <option value="true">Yes</option>
            <option value="false">No</option>
          </select>
        </div>
<div class="card mt-3 p-3">
  <p>Subtotal: ₹ <span id="sub">0.00</span></p>
  <p>Tax: ₹ <span id="tax">0.00</span></p>
  <h5>Grand Total: ₹ <span id="grand">0.00</span></h5>
</div>

        <!-- ================= LINE ITEMS ================= -->
        <h5 class="mt-4">Line Items</h5>

        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Description</th>
              <th width="80">Qty</th>
              <th width="120">Rate</th>
              <th width="120">Discount %</th>
              <th width="120">Total</th>
              <th width="40"></th>
            </tr>
          </thead>
          <tbody id="lineItems">
            <tr>
              <td><input class="form-control desc"></td>
              <td><input type="number" class="form-control qty" value="1"></td>
              <td><input type="number" class="form-control rate" value="0"></td>
              <td><input type="number" class="form-control discount" value="0"></td>
              <td class="line-total">0.00</td>
              <td>
                <button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">×</button>
              </td>
            </tr>
          </tbody>
        </table>

        <button type="button" class="btn btn-secondary" onclick="addRow()">Add Line</button>

        <hr>

        <!-- Totals -->
        <div class="row">
          <div class="col-md-4 offset-md-8">
            <p><b>Subtotal:</b> ₹ <span id="subtotal">0.00</span></p>
            <p><b>Discount:</b> ₹ <span id="discountAmount">0.00</span></p>
            <p><b>Tax:</b> ₹ <span id="taxAmount">0.00</span></p>
            <h5><b>Grand Total:</b> ₹ <span id="grandTotal">0.00</span></h5>
          </div>
        </div>

        <button class="btn btn-success mt-3">Save Draft</button>
      </form>

      <!-- ================= UNBILLED ================= -->
      <div class="card mt-5">
        <div class="card-header"><b>Generate from Unbilled</b></div>
        <div class="card-body">

          <div class="row mb-3">
            <div class="col-md-6">
              <label>Matter</label>
              <select id="unbilled_case" class="form-select"></select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button class="btn btn-primary w-100" onclick="fetchUnbilled()">Fetch</button>
            </div>
          </div>

          <table class="table table-bordered">
            <thead>
              <tr>
                <th width="40"></th>
                <th>Description</th>
                <th width="120">Amount</th>
              </tr>
            </thead>
            <tbody id="unbilledTable"></tbody>
          </table>

        </div>
      </div>

    </div>
    <%- include('../partials/footer') %>
  </div>
</div>

<%- include('../partials/footer-scripts') %>

<script>
/* ---------------- HELPERS ---------------- */
function addRow(desc="", rate=0) {
  const tr = document.createElement("tr");
  tr.innerHTML = `
    <td><input class="form-control desc" value="${desc}"></td>
    <td><input type="number" class="form-control qty" value="1"></td>
    <td><input type="number" class="form-control rate" value="${rate}"></td>
    <td><input type="number" class="form-control discount" value="0"></td>
    <td class="line-total">0.00</td>
    <td><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">×</button></td>
  `;
  document.getElementById("lineItems").appendChild(tr);
}

function removeRow(btn) {
  btn.closest("tr").remove();
  calculateTotals();
}

document.addEventListener("input", calculateTotals);

/* ---------------- TOTALS ---------------- */
function calculateTotals() {
  let subtotal = 0, discountTotal = 0;

  document.querySelectorAll("#lineItems tr").forEach(r => {
    const q = +r.querySelector(".qty").value || 0;
    const rate = +r.querySelector(".rate").value || 0;
    const d = +r.querySelector(".discount").value || 0;

    const line = q * rate;
    const disc = (line * d) / 100;
    const net = line - disc;

    r.querySelector(".line-total").innerText = net.toFixed(2);
    subtotal += net;
    discountTotal += disc;
  });

  const taxRate = +tax_rate.value || 0;
  const taxable = taxableSelect.value === "true";
  const tax = taxable ? (subtotal * taxRate) / 100 : 0;

  subtotalEl.innerText = subtotal.toFixed(2);
  discountEl.innerText = discountTotal.toFixed(2);
  taxEl.innerText = tax.toFixed(2);
  grandEl.innerText = (subtotal + tax).toFixed(2);
}

/* ---------------- UNBILLED ---------------- */
async function fetchUnbilled() {
  const id = unbilled_case.value;
  const r = await fetch(`/billing/api/unbilled-items/${id}`);
  const d = await r.json();
  const t = unbilledTable;
  t.innerHTML = "";

  d.items.forEach(i => {
    t.innerHTML += `
      <tr>
        <td><input type="checkbox" onchange="this.checked && addRow('${i.description}', ${i.amount})"></td>
        <td>${i.description}</td>
        <td>₹ ${i.amount}</td>
      </tr>`;
  });
}

/* ---------------- INIT ---------------- */
const subtotalEl = document.getElementById("subtotal");
const discountEl = document.getElementById("discountAmount");
const taxEl = document.getElementById("taxAmount");
const grandEl = document.getElementById("grandTotal");
const taxableSelect = document.getElementById("taxable");

async function loadCases() {
  const r = await fetch("/billing/api/cases");
  const d = await r.json();
  d.cases.forEach(c => {
    case_id.innerHTML += `<option value="${c.id}">${c.title}</option>`;
    unbilled_case.innerHTML += `<option value="${c.id}">${c.title}</option>`;
  });
}
document.addEventListener("DOMContentLoaded", loadCases);

country.addEventListener("change", e => {
  taxLabel.innerText = e.target.value === "India" ? "GST (%)" : "VAT (%)";
});

</script>

</body>
</html>
