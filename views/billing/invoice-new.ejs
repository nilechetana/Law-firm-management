<%- include('../partials/html') %>
<head>
  <%- include('../partials/title-meta') %>
  <%- include('../partials/head-css') %>
</head>

<body>
<div class="wrapper">
  <%- include('../partials/menu') %>

  <div class="page-content">
    <div class="page-container">

      <h4 class="mb-4">Create Invoice</h4>

      <!-- ================= MAIN INVOICE FORM ================= -->
      <form id="invoiceForm">

        <!-- Client / Case -->
        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label">Client</label>
            <select id="client_id" class="form-select">
              <option value="">Select Client</option>
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">Case</label>
            <select id="case_id" class="form-select">
              <option value="">Select Case</option>
            </select>
          </div>
        </div>

        <!-- Dates -->
        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label">Invoice Date</label>
            <input type="date" id="invoice_date" class="form-control">
          </div>

          <div class="col-md-6">
            <label class="form-label">Due Date</label>
            <input type="date" id="due_date" class="form-control">
          </div>
        </div>

        <!-- Location -->
        <div class="row mb-3">
          <div class="col-md-3">
            <label class="form-label">Country</label>
            <select id="country" class="form-select">
              <option value="India">India</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="col-md-3">
            <label class="form-label">Currency</label>
            <select id="currency" class="form-select">
              <option value="INR">INR (₹)</option>
              <option value="USD">USD ($)</option>
            </select>
          </div>

          <div class="col-md-3">
            <label class="form-label">State</label>
            <input id="state" class="form-control">
          </div>

          <div class="col-md-3">
            <label class="form-label" id="taxLabel">GST (%)</label>
            <input id="tax_rate" type="number" class="form-control" value="18">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Taxable</label>
          <select id="taxable" class="form-select">
            <option value="true">Yes</option>
            <option value="false">No</option>
          </select>
        </div>

        <!-- ================= LINE ITEMS ================= -->
        <h5 class="mt-4">Line Items</h5>

        <div class="row fw-bold text-muted mb-2">
          <div class="col-md-4">Description</div>
          <div class="col-md-2">Qty</div>
          <div class="col-md-2">Rate</div>
          <div class="col-md-2">Discount (%)</div>
        </div>

        <div class="row mb-3">
          <div class="col-md-4">
            <input id="description" class="form-control" placeholder="Service description">
          </div>
          <div class="col-md-2">
            <input id="qty" type="number" class="form-control" value="1">
          </div>
          <div class="col-md-2">
            <input id="rate" type="number" class="form-control" value="0">
          </div>
          <div class="col-md-2">
            <input id="discount" type="number" class="form-control" value="0">
          </div>
        </div>

        <button type="button" class="btn btn-primary" onclick="calculateInvoice()">
          Calculate
        </button>

        <hr>

        <!-- Totals -->
        <p><strong>Subtotal:</strong> ₹ <span id="subtotal">0</span></p>
        <p><strong>Discount:</strong> ₹ <span id="discountAmount">0</span></p>
        <p><strong>Tax:</strong> ₹ <span id="taxAmount">0</span></p>
        <h5><strong>Grand Total:</strong> ₹ <span id="grandTotal">0</span></h5>

        <button class="btn btn-success mt-3">Save Draft</button>
      </form>

      <!-- ================= UNBILLED SECTION (AFTER FORM) ================= -->
      <div class="card mt-5">
        <div class="card-header">
          <b>Generate from Unbilled Time / Expenses</b>
        </div>
        <div class="card-body">

          <div class="row mb-3">
            <div class="col-md-4">
              <label>Matter</label>
              <select id="unbilled_case" class="form-select"></select>
            </div>
            <div class="col-md-3">
              <label>From</label>
              <input type="date" id="from_date" class="form-control">
            </div>
            <div class="col-md-3">
              <label>To</label>
              <input type="date" id="to_date" class="form-control">
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button class="btn btn-primary w-100" onclick="fetchUnbilled()">
                Fetch
              </button>
            </div>
          </div>

          <table class="table table-bordered">
            <thead>
              <tr>
                <th width="40"></th>
                <th>Description</th>
                <th width="120">Amount</th>
              </tr>
            </thead>
            <tbody id="unbilledTable">
              <tr>
                <td colspan="3" class="text-center text-muted">
                  No data
                </td>
              </tr>
            </tbody>
          </table>

        </div>
      </div>

    </div>
    <%- include('../partials/footer') %>
  </div>
</div>

<%- include('../partials/footer-scripts') %>

<script>
/* ================= DROPDOWNS ================= */
async function loadCases() {
  const r = await fetch("/billing/api/cases");
  const d = await r.json();
  const c1 = document.getElementById("case_id");
  const c2 = document.getElementById("unbilled_case");
  d.cases.forEach(c => {
    c1.innerHTML += `<option value="${c.id}">${c.title}</option>`;
    c2.innerHTML += `<option value="${c.id}">${c.title}</option>`;
  });
}
document.addEventListener("DOMContentLoaded", loadCases);

/* ================= TAX LABEL ================= */
document.getElementById("country").addEventListener("change", e => {
  document.getElementById("taxLabel").innerText =
    e.target.value === "India" ? "GST (%)" : "VAT (%)";
});

/* ================= CALCULATION ================= */
function calculateInvoice() {
  const qty = Number(document.getElementById("qty").value || 0);
  const rate = Number(document.getElementById("rate").value || 0);
  const discount = Number(document.getElementById("discount").value || 0);
  const taxRate = Number(document.getElementById("tax_rate").value || 0);
  const taxable = document.getElementById("taxable").value === "true";

  const lineTotal = qty * rate;
  const discountAmount = (lineTotal * discount) / 100;
  const afterDiscount = lineTotal - discountAmount;
  const taxAmount = taxable ? (afterDiscount * taxRate) / 100 : 0;
  const grandTotal = afterDiscount + taxAmount;

  document.getElementById("subtotal").innerText = afterDiscount.toFixed(2);
  document.getElementById("discountAmount").innerText = discountAmount.toFixed(2);
  document.getElementById("taxAmount").innerText = taxAmount.toFixed(2);
  document.getElementById("grandTotal").innerText = grandTotal.toFixed(2);
}
/* ================= UNBILLED ================= */
async function fetchUnbilled() {
  const id = unbilled_case.value;
  if (!id) return;

  const r = await fetch(`/billing/api/unbilled-items/${id}`);
  const d = await r.json();
  const tbody = document.getElementById("unbilledTable");
  tbody.innerHTML = "";

  if (!d.success || d.items.length === 0) {
    tbody.innerHTML = `<tr><td colspan="3" class="text-center">No data</td></tr>`;
    return;
  }

  d.items.forEach(i => {
    tbody.innerHTML += `
      <tr>
        <td><input type="checkbox"></td>
        <td>${i.description}</td>
        <td>₹ ${Number(i.amount).toFixed(2)}</td>
      </tr>
    `;
  });
}
</script>

</body>
</html>
