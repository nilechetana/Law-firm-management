<%- include('partials/html') %>

<head>
    <%- include('partials/title-meta') %>
    <%- include('partials/head-css') %>
</head>

<body>
<div class="wrapper">

    <%- include('partials/menu') %>

    <div class="page-content">
        <div class="page-container">

            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h4 class="page-title">Invoice Details</h4>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">

                    <!-- HEADER -->
                    <div class="d-flex justify-content-between mb-4">
                        <img src="/images/logo-dark.png" height="24">

                        <div class="text-end">
                            <span id="statusBadge" class="badge bg-warning-subtle text-warning">
                                Draft
                            </span>
                            <h3 class="fw-bold">
                                Invoice #<span id="invoiceId"></span>
                            </h3>
                        </div>
                    </div>

                    <!-- META -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <h6>Invoice Date</h6>
                            <p id="invoiceDate" class="text-muted"></p>
                        </div>

                        <div class="col-md-4">
                            <h6>Due Date</h6>
                            <p id="dueDate" class="text-muted"></p>
                        </div>

                        <div class="col-md-4">
                            <h6>Location</h6>
                            <p class="text-muted">
                                <span id="country"></span>,
                                <span id="state"></span>
                            </p>
                        </div>
                    </div>

                    <!-- ITEMS TABLE -->
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Description</th>
                                    <th>Qty</th>
                                    <th>Rate</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody id="itemsBody"></tbody>
                        </table>
                    </div>

                    <!-- TOTALS -->
                    <div class="row justify-content-end">
                        <div class="col-md-4">
                            <table class="table">
                                <tr>
                                    <td>Subtotal</td>
                                    <td class="text-end">₹ <span id="subtotal"></span></td>
                                </tr>
                                <tr>
                                    <td>Tax</td>
                                    <td class="text-end">₹ <span id="taxTotal"></span></td>
                                </tr>
                                <tr class="fw-bold border-top">
                                    <td>Grand Total</td>
                                    <td class="text-end">₹ <span id="grandTotal"></span></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- ADD PAYMENT -->
                    <hr>
                    <h5 class="mt-4">Add Payment</h5>

                    <form id="paymentForm">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label>Amount</label>
                                <input type="number" id="payment_amount" class="form-control" required>
                            </div>

                            <div class="col-md-4">
                                <label>Paid On</label>
                                <input type="date" id="payment_date" class="form-control" required>
                            </div>

                            <div class="col-md-4">
                                <label>Reference</label>
                                <input type="text" id="payment_reference" class="form-control">
                            </div>
                        </div>

                        <button class="btn btn-success">Add Payment</button>
                    </form>

                    <div id="paymentMsg" class="mt-3"></div>

                    <!-- NOTES -->
                    <div class="mt-4">
                        <h6>Notes</h6>
                        <p id="notes" class="text-muted"></p>
                    </div>

                    <!-- ACTIONS -->
                    <div class="d-print-none mt-4 text-center">
                        <button id="finalizeBtn" class="btn btn-danger">
                            Finalize Invoice
                        </button>
                        <button onclick="window.print()" class="btn btn-primary ms-2">
                            Print
                        </button>
                    </div>

                </div>
            </div>

        </div>

        <%- include('partials/footer') %>
    </div>
</div>

<%- include('partials/footer-scripts') %>

<script>
const invoiceId = window.location.pathname.split("/").pop();

/* LOAD INVOICE */
async function loadInvoice() {
    const res = await fetch(`/billing/api/invoices/${invoiceId}`);
    const data = await res.json();

    if (!data.success) {
        alert("Invoice not found");
        return;
    }

    const inv = data.invoice;
    const items = data.items;

    document.getElementById("invoiceId").innerText = inv.id;
    document.getElementById("invoiceDate").innerText = inv.invoice_date;
    document.getElementById("dueDate").innerText = inv.due_date;
    document.getElementById("country").innerText = inv.country;
    document.getElementById("state").innerText = inv.state;
    document.getElementById("subtotal").innerText = inv.subtotal;
    document.getElementById("taxTotal").innerText = inv.tax_total;
    document.getElementById("grandTotal").innerText = inv.grand_total;
    document.getElementById("notes").innerText = inv.notes || "-";

    const badge = document.getElementById("statusBadge");
    if (inv.status === "final") {
        badge.className = "badge bg-success-subtle text-success";
        badge.innerText = "Final";
        document.getElementById("finalizeBtn").disabled = true;
        document.getElementById("finalizeBtn").innerText = "Already Finalized";
    }

    const tbody = document.getElementById("itemsBody");
    tbody.innerHTML = "";

    items.forEach((item, i) => {
        tbody.innerHTML += `
            <tr>
                <td>${i + 1}</td>
                <td>${item.description}</td>
                <td>${item.qty}</td>
                <td>₹ ${item.rate}</td>
                <td class="text-end">₹ ${item.line_total}</td>
            </tr>
        `;
    });
}

/* FINALIZE */
document.getElementById("finalizeBtn").addEventListener("click", async () => {
    if (!confirm("Finalize this invoice?")) return;

    const res = await fetch(`/billing/api/invoices/${invoiceId}/finalize`, {
        method: "POST"
    });

    const data = await res.json();

    if (data.success) {
        alert("Invoice finalized");
        location.reload();
    } else {
        alert(data.error);
    }
});

/* ADD PAYMENT */
document.getElementById("paymentForm").addEventListener("submit", async (e) => {
    e.preventDefault();

    const payload = {
        amount: document.getElementById("payment_amount").value,
        paid_on: document.getElementById("payment_date").value,
        reference: document.getElementById("payment_reference").value
    };

    const res = await fetch(`/billing/api/invoices/${invoiceId}/payments`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
    });

    const data = await res.json();

    if (data.success) {
        document.getElementById("paymentMsg").innerHTML =
            `<div class="alert alert-success">Payment added successfully</div>`;
        document.getElementById("paymentForm").reset();
    } else {
        document.getElementById("paymentMsg").innerHTML =
            `<div class="alert alert-danger">${data.error}</div>`;
    }
});

loadInvoice();
</script>

</body>
</html>
