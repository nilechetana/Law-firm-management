<%- include('partials/html') %>
<head>
  <%- include('partials/title-meta') %>
  <%- include('partials/head-css') %>
</head>

<body>
<div class="wrapper">
  <%- include('partials/menu') %>

  <div class="page-content">
    <div class="page-container">

      <h4 class="mb-4">Create Invoice</h4>

      <form id="invoiceForm">

        <!-- CLIENT & CASE -->
        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label">Client</label>
            <select id="client_id" class="form-select">
              <option value="">Select Client</option>
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">Case</label>
            <select id="case_id" class="form-select">
              <option value="">Select Case</option>
            </select>
          </div>
        </div>

        <!-- DATES -->
        <div class="row mb-3">
          <div class="col-md-6">
            <label>Invoice Date</label>
            <input type="date" id="invoice_date" class="form-control">
          </div>
          <div class="col-md-6">
            <label>Due Date</label>
            <input type="date" id="due_date" class="form-control">
          </div>
        </div>

        <!-- LOCATION / TAX -->
        <div class="row mb-3">
          <div class="col-md-3">
            <label>Country</label>
            <select id="country" class="form-select">
              <option value="India">India</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="col-md-3">
            <label>Currency</label>
            <select id="currency" class="form-select">
              <option value="INR">INR (₹)</option>
              <option value="USD">USD ($)</option>
            </select>
          </div>

          <div class="col-md-3">
            <label>State</label>
            <input type="text" id="state" class="form-control">
          </div>

          <div class="col-md-3">
            <label id="taxLabel">GST (%)</label>
            <input type="number" id="tax_rate" class="form-control" value="18">
          </div>
        </div>

        <div class="mb-3">
          <label>Taxable</label>
          <select id="taxable" class="form-select">
            <option value="true">Yes</option>
            <option value="false">No</option>
          </select>
        </div>

        <!-- LINE ITEM -->
        <h5 class="mt-4">Line Item</h5>

        <div class="row mb-3">
          <div class="col-md-4">
            <label>Description</label>
            <input type="text" id="description" class="form-control" placeholder="Service description">
          </div>

          <div class="col-md-2">
            <label>Qty</label>
            <input type="number" id="qty" class="form-control" value="1">
          </div>

          <div class="col-md-2">
            <label>Rate</label>
            <input type="number" id="rate" class="form-control" value="0">
          </div>

          <div class="col-md-2">
            <label>Discount (%)</label>
            <input type="number" id="discount" class="form-control" value="0">
          </div>
        </div>

        <button type="button" class="btn btn-primary" onclick="calculateInvoice()">
          Calculate
        </button>

        <hr>

        <!-- SUMMARY -->
        <p><strong>Subtotal:</strong> ₹ <span id="subtotal">0</span></p>
        <p><strong>Discount:</strong> ₹ <span id="discountAmount">0</span></p>
        <p><strong>Tax:</strong> ₹ <span id="taxAmount">0</span></p>
        <h5><strong>Grand Total:</strong> ₹ <span id="grandTotal">0</span></h5>

        <hr>

        <!-- NOTES & TERMS -->
        <div class="row mt-3">
          <div class="col-md-6">
            <label>Notes</label>
            <textarea id="notes" class="form-control" rows="4"
              placeholder="Additional notes for client"></textarea>
          </div>

          <div class="col-md-6">
            <label>Terms & Conditions</label>
            <textarea id="terms" class="form-control" rows="4"
              placeholder="Payment terms, due date, penalties etc."></textarea>
          </div>
        </div>

        <button class="btn btn-success mt-4">Save Invoice</button>

      </form>

    </div>
    <%- include('partials/footer') %>
  </div>
</div>

<%- include('partials/footer-scripts') %>

<script>
/* ===============================
   PAGE LOAD
================================ */
document.addEventListener("DOMContentLoaded", () => {
  document.getElementById("state").value = "";
  loadClients();
  loadCases();
});

/* ===============================
   COUNTRY CHANGE → GST / VAT
================================ */
document.getElementById("country").addEventListener("change", function () {
  document.getElementById("state").value = "";
  document.getElementById("taxLabel").innerText =
    this.value === "India" ? "GST (%)" : "VAT (%)";
});

/* ===============================
   CALCULATION
================================ */
function calculateInvoice() {
  const qty = Number(qty.value);
  const rate = Number(rate.value);
  const discountPercent = Number(discount.value);
  const taxPercent = Number(tax_rate.value);
  const taxable = taxable.value === "true";

  const subtotal = qty * rate;
  const discountAmt = (subtotal * discountPercent) / 100;
  const afterDiscount = subtotal - discountAmt;
  const taxAmt = taxable ? (afterDiscount * taxPercent) / 100 : 0;
  const total = afterDiscount + taxAmt;

  subtotalEl.innerText = subtotal.toFixed(2);
  discountAmount.innerText = discountAmt.toFixed(2);
  taxAmount.innerText = taxAmt.toFixed(2);
  grandTotal.innerText = total.toFixed(2);
}

const subtotalEl = document.getElementById("subtotal");
const discountAmount = document.getElementById("discountAmount");
const taxAmount = document.getElementById("taxAmount");
const grandTotal = document.getElementById("grandTotal");

/* ===============================
   SUBMIT INVOICE
================================ */
document.getElementById("invoiceForm").addEventListener("submit", async e => {
  e.preventDefault();

  const payload = {
    invoice_date: invoice_date.value,
    due_date: due_date.value,
    currency: currency.value,
    country: country.value,
    state: state.value,
    notes: notes.value,
    terms: terms.value,
    items: [{
      description: description.value,
      qty: Number(qty.value),
      rate: Number(rate.value),
      discount: Number(discount.value),
      taxable: taxable.value === "true",
      tax_rate: Number(tax_rate.value)
    }]
  };

  const res = await fetch("/billing/api/invoices", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload)
  });

  const data = await res.json();
  alert("Invoice Created! ID: " + data.invoice_id);
  window.location.href = "/billing/invoices";
});

/* ===============================
   LOAD DROPDOWNS
================================ */
async function loadClients() {
  const res = await fetch("/billing/api/clients");
  const data = await res.json();
  const el = document.getElementById("client_id");

  el.innerHTML = '<option value="">Select Client</option>';
  data.clients.forEach(c => {
    el.innerHTML += `<option value="${c.id}">${c.name}</option>`;
  });
}

async function loadCases() {
  const res = await fetch("/billing/api/cases");
  const data = await res.json();
  const el = document.getElementById("case_id");

  el.innerHTML = '<option value="">Select Case</option>';
  data.cases.forEach(c => {
    el.innerHTML += `<option value="${c.id}">${c.title}</option>`;
  });
}
</script>

</body>
</html>
