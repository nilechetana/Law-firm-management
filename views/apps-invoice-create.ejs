<%- include('partials/html') %>

<head>
    <%- include('partials/title-meta') %>
    <link href="/vendor/flatpickr/flatpickr.min.css" rel="stylesheet" type="text/css" />
    <%- include('partials/head-css') %>
</head>

<body>
<div class="wrapper">

    <%- include('partials/menu') %>

    <div class="page-content">
        <div class="page-container">
            <div class="row">
                <div class="col-12">

                    <div class="card">
                        <form id="invoiceForm">
                            <div class="card-body">

                                <h4 class="mb-3">Create Invoice</h4>

                                <!-- Client & Case -->
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Client</label>
                                        <select class="form-select" required>
                                            <option value="">Select Client</option>
                                            <option>ABC Pvt Ltd</option>
                                            <option>Rahul Sharma</option>
                                            <option>XYZ Associates</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Case</label>
                                        <select class="form-select" required>
                                            <option value="">Select Case</option>
                                            <option>Property Dispute</option>
                                            <option>Contract Case</option>
                                            <option>Criminal Appeal</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Dates -->
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Invoice Date</label>
                                        <input type="text" class="form-control" placeholder="DD/MM/YYYY" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Due Date</label>
                                        <input type="text" class="form-control" placeholder="DD/MM/YYYY" required>
                                    </div>
                                </div>

                                <hr>

                                <!-- Country / Currency / State / Tax -->
                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Country</label>
                                        <select id="country" class="form-select">
                                            <option value="india">India</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">Currency</label>
                                        <select class="form-select">
                                            <option>INR (₹)</option>
                                            <option>USD ($)</option>
                                            <option>EUR (€)</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3" id="stateDiv">
                                        <label class="form-label">State</label>
                                        <input type="text" class="form-control" placeholder="State">
                                    </div>

                                    <div class="col-md-3">
                                        <label id="taxLabel" class="form-label">GST (%)</label>
                                        <input type="number" id="taxPercent" class="form-control" value="18" min="0" max="100">
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Taxable</label>
                                        <select id="taxable" class="form-select">
                                            <option value="yes">Yes</option>
                                            <option value="no">No</option>
                                        </select>
                                    </div>
                                </div>

                                <hr>

                                <!-- Line Item -->
                                <h5>Line Item</h5>
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label>Description</label>
                                        <input type="text" class="form-control" required>
                                    </div>
                                    <div class="col-md-2">
                                        <label>Qty</label>
                                        <input type="number" id="qty" class="form-control" min="1" required>
                                    </div>
                                    <div class="col-md-2">
                                        <label>Rate</label>
                                        <input type="number" id="rate" class="form-control" min="0" required>
                                    </div>
                                    <div class="col-md-2">
                                        <label>Discount (%)</label>
                                        <input type="number" id="discount" class="form-control" value="0" min="0" max="100">
                                    </div>
                                </div>

                                <button type="button" class="btn btn-primary mb-3" onclick="calculateInvoice()">
                                    Calculate
                                </button>

                                <hr>

                                <!-- Summary -->
                                <p>Subtotal: ₹ <span id="subtotal">0</span></p>
                                <p>Discount: ₹ <span id="discountAmount">0</span></p>
                                <p>Tax: ₹ <span id="taxAmount">0</span></p>
                                <h5>Grand Total: ₹ <span id="grandTotal">0</span></h5>
                                    <hr>

                                            <!-- Notes & Terms -->
                                            <div class="row mt-3">
                                             <div class="col-md-6">
                                               <label class="form-label">Notes</label>
                                                       <textarea class="form-control" rows="4"
                                                          placeholder="Additional notes for the client (dummy)"></textarea>
                                               </div>

                                               <div class="col-md-6">
                                                 <label class="form-label">Terms & Conditions</label>
                                                     <textarea class="form-control" rows="4"
                                            placeholder="Payment terms, due date, etc. (dummy)"></textarea>
                                               </div>
                                        </div>

                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>

        <%- include('partials/footer') %>
    </div>
</div>

<%- include('partials/footer-scripts') %>

<script>
function calculateInvoice() {
    const qty = Number(document.getElementById("qty").value || 0);
    const rate = Number(document.getElementById("rate").value || 0);
    const discountPercent = Number(document.getElementById("discount").value || 0);
    const taxPercent = Number(document.getElementById("taxPercent").value || 0);
    const taxable = document.getElementById("taxable").value;

    let subtotal = qty * rate;
    let discount = (subtotal * discountPercent) / 100;
    let afterDiscount = subtotal - discount;
    let tax = taxable === "yes" ? (afterDiscount * taxPercent) / 100 : 0;
    let total = afterDiscount + tax;

    document.getElementById("subtotal").innerText = subtotal.toFixed(2);
    document.getElementById("discountAmount").innerText = discount.toFixed(2);
    document.getElementById("taxAmount").innerText = tax.toFixed(2);
    document.getElementById("grandTotal").innerText = total.toFixed(2);
}

document.getElementById("country").addEventListener("change", function () {
    const taxLabel = document.getElementById("taxLabel");
    const stateDiv = document.getElementById("stateDiv");

    if (this.value === "india") {
        taxLabel.innerText = "GST (%)";
        stateDiv.style.display = "block";
    } else {
        taxLabel.innerText = "VAT (%)";
        stateDiv.style.display = "none";
    }
});
</script>

</body>
</html>
